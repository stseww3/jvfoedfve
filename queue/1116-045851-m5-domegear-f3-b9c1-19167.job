args=--no-push --tail 150 $'env PYTHONPATH=build python - <<EOF\nimport math\nfrom scenes import obs\nfrom scenes.obs.machines import dome as G\nc = obs.build()\ndef kind(b):\n    return "." if b is None else b.rpartition(":")[2].partition("[")[0]\nnames = {}\ndef code(b):\n    k = kind(b)\n    if k == ".":\n        return ".."\n    if k not in names:\n        names[k] = "%02d" % len(names)\n    return names[k]\nfor z in (-3, -2, 0, 2, 3):\n    print("z", z, "  x -12..-4")\n    for y in range(29, 12, -1):\n        print("%3d " % y + " ".join(code(c.get(x, y, z)) for x in range(-12, -3)))\nfor k, n in sorted(names.items(), key=lambda kv: kv[1]):\n    print(n, k)\n(x0, y0), (x1, y1) = G.on_curve(G.BAR_DEG), G.on_curve(G.SHUT_DEG)\nphi = math.radians(G.slope(G.SHUT_DEG) - G.slope(G.BAR_DEG))\ncs, sn = math.cos(phi), math.sin(phi)\nbx, by = x1 - (cs * x0 - sn * y0), y1 - (sn * x0 + cs * y0)\ndet = (1.0 - cs) ** 2 + sn ** 2\ncx, cy = ((1.0 - cs) * bx - sn * by) / det, (sn * bx + (1.0 - cs) * by) / det\nr = math.hypot(x0 - cx, y0 - cy)\nt0 = math.degrees(math.atan2(y0 - cy, x0 - cx))\nprint("C", round(cx, 4), round(cy, 4), "R", round(r, 4), "polar0", round(t0, 3), "turn", round(math.degrees(phi), 3))\nprint("bar", round(x0, 3), round(y0, 3), "shut", round(x1, 3), round(y1, 3), "roll", G.roll_at(), "winch", G.winch_at())\nworst = 0.0\nfor i in range(0, 201):\n    a = math.radians(t0) + phi * i / 200.0\n    x, y = cx + r * math.cos(a), cy + r * math.sin(a) - G.LEDGE_Y\n    A, Bb = G._axes()\n    f = (x / A) ** 2 + (y / Bb) ** 2 - 1.0\n    g = math.hypot(2 * x / A ** 2, 2 * y / Bb ** 2)\n    worst = max(worst, abs(f) / g)\nprint("worst off the ellipse, px:", round(worst * 16, 3))\nfor d in range(0, 80, 4):\n    a = math.radians(t0 + d)\n    x, y = cx + r * math.cos(a), cy + r * math.sin(a)\n    wx, wy = G.AX + x, y\n    print("below the bar by", d, "deg: dome x", round(x, 2), "y", round(y, 2), "cell", (math.floor(wx), math.floor(wy)), [kind(c.get(math.floor(wx), math.floor(wy), z)) for z in (-2, 0, 2)])\nEOF' 
