branch=cursor/c164-clocks-f3-00d6
head=94039838d85d4b900b46dcc1a2dca468c26355b5
args=--no-push --tail 70 $'cd build && python ../tools/check.py --scene obs_mach_clocks | grep -E "^\\[(FAIL|WARN)|blocks|motion|^result|^ +[a-z]" | cut -c1-330 ; python ../tools/check.py --scene obs_mach_clocks_b | grep -E "^\\[(FAIL|WARN)|motion|^result" | cut -c1-330 ; python - <<"EOF"\nfrom scenes.obs_mach_clocks import build\nfrom scenes.obs.machines import clock\nfrom scenes.obs.motion import _kit as MK\nfrom artkit.canvas import Canvas\n\ndef same(a, b, tol=1e-4):\n    return all(abs(x - y) < tol for x, y in zip(a, b)) or all(abs(x + y) < tol for x, y in zip(a, b))\n\nc = build()\nbook = c.motion\nfor p in book.parts:\n    if p.name.startswith("mach_clock"):\n        print(p.name, p.kind, "cycle", p.cycle, "steps", len(p.steps), "lead", p.lead, "turn %.1f" % p.turn, "stray px %.3f" % (p.stray * 16.0), "at", tuple(round(v, 3) for v in p.pos))\nball = [p for p in book.parts if p.kind == "slide" and p.name.startswith("mach_clock_ball")]\nfor p in ball:\n    print("ball steps (tick, ticks, turn, blocks):", [(t, d, round(s, 3)) for t, d, _a, s in p.steps])\n# the way the hands turn: a quarter of a turn on in the loop is the pose of the same hand placed a quarter later\nlater = {"m": (8, 10), "h": (10, 55)}\nok = True\nfor letter, time in later.items():\n    c2 = Canvas()\n    clock.master(c2, time=time)\n    for name in ("mach_clock_master_hand_" + letter,):\n        part = [p for p in book.parts if p.name == name][0]\n        placed = [e for e in c2.entities if MK._model_name(e[3]) == name][0][3]["transformation"]\n        q, t = part.pose(-90.0, 0.0)\n        good = same(q, [float(v) for v in placed["left_rotation"]]) and all(abs(a - float(b)) < 1e-4 for a, b in zip(t, placed["translation"]))\n        wrong = part.pose(90.0, 0.0)\n        bad = same(wrong[0], [float(v) for v in placed["left_rotation"]])\n        ok = ok and good and not bad\n        print(name, "a quarter on is the hand placed at", time, ":", good, "| the other way round matches:", bad)\n    for p in book.parts:\n        if p.name == "mach_clock_hand_" + letter:\n            first = p.steps[1]\n            print("  tower", p.name, "second step: tick", first[0], "turned", round(first[2], 3), "degrees (negative is clockwise)")\nprint("hands turn clockwise:", ok)\nprint("ticks_to(8) =", clock.ticks_to(8), " ticks_to(8, 15) =", clock.ticks_to(8, 15), " ticks_to(7, 55) =", clock.ticks_to(7, 55), " ball_moves =", clock.ball_moves())\nEOF' 
