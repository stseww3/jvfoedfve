args=--no-push --tail 70 $'cd build && python ../tools/check.py --scene obs_mach_clocks | grep -E "^\\[(FAIL|WARN)|regen|entities|views|motion|^result|chain of" | cut -c1-260 ; python ../tools/check.py --scene obs_mach_clocks_b | grep -E "^\\[(FAIL|WARN)|^result" | cut -c1-260 ; python - <<"EOF"\nfrom scenes.obs_mach_clocks import build\nfrom scenes.obs.machines import clock\nfrom scenes.obs.motion import _kit as MK\nc = build()\nfor p in c.motion.parts:\n    if p.name.startswith("mach_clock_master"):\n        print(p.name, p.kind, "cycle", p.cycle, "steps", len(p.steps), "lead", p.lead, "turn %.1f" % p.turn, "stray px %.3f" % (p.stray * 16.0), "first steps", [(t, d, round(a, 2)) for t, d, a, _s in p.steps[:3]], "last", [(t, d, round(a, 2)) for t, d, a, _s in p.steps[-1:]])\nprint("strikes", clock.strikes())\nprint("quarters", clock.quarters())\nm = clock.models()["mach_clock_master_hand_s"]\nprint("seconds hand:", len(m.parts), "elements")\ntry:\n    clock.drive(c, "x")\nexcept ValueError as e:\n    print("refused:", e)\nEOF' 
