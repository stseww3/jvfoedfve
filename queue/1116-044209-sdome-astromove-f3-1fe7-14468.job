args=--no-push --limit 600 --tail 40 $'python tools/check.py --scene obs_mach_meridian_astrograph > /tmp/sdome_m.txt 2>&1; A=$?; grep -E "^\\[(FAIL|WARN)|motion|^result" /tmp/sdome_m.txt | cut -c1-200; python tools/check.py --scene obs_int_astroroom > /tmp/sdome_r.txt 2>&1; B=$?; grep -E "^\\[(FAIL|WARN)|motion|^result" /tmp/sdome_r.txt | cut -c1-200; cd build; python -m scenes.obs.machines.astro check | tail -n 1; python -m scenes.obs.machines.meridian check | tail -n 1; python -m scenes.obs.interiors.astroroom check 2>&1 | tail -n 1 | cut -c1-200; python -c "\nfrom scenes.obs.machines import astro, meridian\nfrom scenes.obs.interiors import astroroom\nfrom artkit import models as M\nprint(\\"VIEW\\", astro.VIEW, meridian.VIEW, astroroom.VIEW, M.NEAR)"; exit $((A+B))' 
