head=cd4c034806b40c2a01c0a54ee97f256779b8994d
args=--no-push --tail 190 $'env PYTHONPATH=build python - <<EOF\nfrom scenes import obs\nc = obs.build()\ndef kind(b):\n    return "." if b is None else b.rpartition(":")[2].partition("[")[0]\nX = range(57, 72)\nprint("top y of what stands in each column (y -6..30); -- nothing above the paving; x", X[0], "..", X[-1])\nfor z in range(6, 46):\n    row = []\n    for x in X:\n        top = None\n        for y in range(30, -6, -1):\n            if c.get(x, y, z) is not None:\n                top = y\n                break\n        row.append("--" if top is None else "%2d" % top)\n    print("z %3d  " % z + " ".join(row))\nnames = {}\nprint("the kind at y -6 (first air above the paving) and y -7")\nfor y in (-6, -7):\n    for z in range(6, 46):\n        row = []\n        for x in X:\n            k = kind(c.get(x, y, z))\n            if k == ".":\n                row.append("..")\n            else:\n                names.setdefault(k, "%02d" % len(names))\n                row.append(names[k])\n        print("y %3d z %3d  " % (y, z) + " ".join(row))\nfor k, n in sorted(names.items(), key=lambda kv: kv[1]):\n    print(n, k)\nents = getattr(c, "entities", None)\nprint("entities:", type(ents).__name__)\nn = 0\ntry:\n    for e in ents:\n        pos = e.get("pos") if isinstance(e, dict) else getattr(e, "pos", None)\n        if pos is None and isinstance(e, (tuple, list)):\n            pos = e[:3]\n        if pos is None:\n            continue\n        x, y, z = pos[0], pos[1], pos[2]\n        if 57 <= x <= 72 and 6 <= z <= 46 and y < 30:\n            n += 1\n            if n <= 60:\n                print("  ", round(x, 2), round(y, 2), round(z, 2), str(e)[:150].replace(chr(39), ""))\nexcept Exception as err:\n    print("entities not read:", err)\nprint("entities in the strip:", n)\nEOF' 
