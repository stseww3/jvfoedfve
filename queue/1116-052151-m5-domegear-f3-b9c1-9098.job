args=--no-push --tail 120 $'env PYTHONPATH=build python - <<EOF\nfrom scenes import obs\nc = obs.build()\ndef kind(b):\n    return "." if b is None else b.rpartition(":")[2].partition("[")[0]\nX = range(57, 73)\nprint("top y of what stands in each column (y -6..30); -- nothing above the paving; x", X[0], "..", X[-1])\nfor z in range(6, 46):\n    row = []\n    for x in X:\n        top = None\n        for y in range(30, -7, -1):\n            if c.get(x, y, z) is not None:\n                top = y\n                break\n        row.append("--" if top is None or top < -6 else "%2d" % top)\n    print("z %3d  " % z + " ".join(row))\nnames = {}\nprint("the kind at y -7 (the paving)")\nfor z in range(6, 46):\n    row = []\n    for x in X:\n        k = kind(c.get(x, -7, z))\n        if k == ".":\n            row.append("..")\n        else:\n            names.setdefault(k, "%02d" % len(names))\n            row.append(names[k])\n    print("z %3d  " % z + " ".join(row))\nfor k, n in sorted(names.items(), key=lambda kv: kv[1]):\n    print(n, k)\nEOF' 
