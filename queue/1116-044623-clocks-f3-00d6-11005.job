args=--no-push --tail 70 $'cd build && python ../tools/check.py --scene obs_mach_clocks | grep -E "^\\[(FAIL|WARN)|regen|entities|strays|refs|views|motion|^result" | cut -c1-260 ; python ../tools/check.py --scene obs_mach_clocks_b | grep -E "^\\[(FAIL|WARN)|^result" | cut -c1-260 ; python - <<"EOF"\nfrom collections import Counter\nfrom scenes.obs_mach_clocks import build\nfrom scenes.obs.machines import clock\nfrom scenes.obs.motion import _kit as MK\nc = build()\nrows = Counter((MK._model_name(e[3]), float(e[3].get("view_range", 1.0))) for e in c.entities if str(MK._model_name(e[3]) or "").startswith("mach_clock"))\nfor (name, view), n in sorted(rows.items()):\n    print(f"{name:28s} view_range {view:g} x{n}")\nfor name in ("mach_clock_face", "mach_clock_face_open"):\n    m = clock.models()[name]\n    print(name, len(m.parts), "elements")\nprint("works_sides():", clock.works_sides())\nEOF' 
